# npm provenance configuration (PORCH-001 AC-4 / npm provenance surface).
# `publish-provenance=true` attests every `npm publish` with a build provenance
# statement. The attestation is supplied end-to-end by CI (GitHub Actions OIDC
# token) — see the pipelines task. Local `npm publish` therefore requires the
# CI OIDC context; without it, npm surfaces the provenance requirement.
publish-provenance=true
